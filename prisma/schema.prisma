// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Admin kullanıcıları
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Genel site ayarları
model SiteSettings {
  id              String   @id @default("default")
  siteName        String   @default("Gökkuşağı Kurumsal Temizlik Hizmetleri")
  siteTitle       String   @default("Gökkuşağı Kurumsal Temizlik Hizmetleri - İstanbul Profesyonel Temizlik Şirketi")
  siteDescription String   @default("İstanbul'da profesyonel temizlik hizmetleri. Ev, ofis, AVM, otel, villa temizliği. Boş ev, inşaat sonrası, dış cephe cam temizliği. Uygun fiyat, kaliteli hizmet.")
  siteKeywords    String   @default("temizlik şirketi istanbul, profesyonel temizlik hizmeti, ev temizliği, ofis temizliği, AVM temizliği, otel temizliği, villa temizliği, boş ev temizliği, inşaat sonrası temizlik, dış cephe cam temizliği, Gökkuşağı Temizlik")
  siteUrl         String   @default("https://gokkusagitemizlik.com")
  siteAuthor      String   @default("Gökkuşağı Kurumsal Temizlik Hizmetleri")
  logoUrl         String?
  faviconUrl      String?
  ogImageUrl      String?  @default("https://gokkusagitemizlik.com/assets/logo_new.png")
  copyrightText   String?  @default("GÖKKUŞAĞI Temizlik Hizmetleri. Tüm hakları saklıdır.")
  language        String   @default("tr")
  geoRegion       String   @default("TR-34")
  geoPlacename    String   @default("İstanbul")
  updatedAt       DateTime @updatedAt
}

// Analitik ve tag ayarları
model AnalyticsSettings {
  id                      String   @id @default("default")
  // Google Analytics
  googleAnalyticsId       String?  @default("G-6WLCFMS9Q6")
  // Google Ads
  googleAdsId             String?  @default("AW-17651373667")
  googleAdsPhoneLabel     String?  @default("ctz6COfNqd4bEOOs6uBB")
  googleAdsFormLabel      String?  @default("sn1UCPfN564bEOOs6uBB")
  // Search Console Doğrulama Kodları
  googleSearchConsole     String?
  yandexWebmaster         String?
  bingWebmaster           String?
  // Yandex Metrica
  yandexMetricaId         String?
  updatedAt               DateTime @updatedAt
}

// İletişim Bilgileri
model ContactInfo {
  id            String   @id @default("default")
  phones        String   @default("[{\"number\": \"0546 763 02 61\", \"raw\": \"+905467630261\", \"label\": \"Telefon\"}]")
  whatsapp      String   @default("+905467630261")
  email         String   @default("info@gokkusagitemizlik.com")
  address       String   @default("İKİTELİ OSB MAH. İSTEKS B6 BLOK SK. NO:19 BAŞAKŞEHİR/İSTANBUL")
  workingHours  String   @default("7/24 Hizmet")
  socialMedia   String   @default("{\"facebook\": \"https://www.facebook.com/gokkusagitemizlik\", \"instagram\": \"https://www.instagram.com/gokkusagitemizlik\", \"twitter\": \"\", \"linkedin\": \"\"}")
  mapEmbedUrl   String?
  updatedAt     DateTime @updatedAt
}
